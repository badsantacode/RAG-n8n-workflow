    {
      "parameters": {
        "jsCode": "// Получаем все элементы от предыдущей ноды\nconst items = $input.all();\n\n// Массив для хранения текстовых блоков каждого документа\nconst formattedDocuments = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Проверяем наличие необходимых данных, чтобы избежать ошибок\n  if (data && data.document) {\n    const pageContent = data.document.pageContent || '';\n    \n    // Превращаем объект метаданных в читаемую строку (ключ: значение)\n    const metadataObj = data.document.metadata || {};\n    const metadataStr = Object.entries(metadataObj)\n      .map(([key, value]) => `${key}: ${typeof value === 'object' ? JSON.stringify(value) : value}`)\n      .join('\\n');\n    \n    const relevanceScore = `Relevance Score: ${data.relevance_score ?? 'N/A'}`;\n    \n    // Объединяем внутренности одного документа через ОДНУ пустую строку\n    const singleDocText = [pageContent, metadataStr, relevanceScore]\n      .filter(block => block.trim() !== '') // Убираем пустые блоки, если каких-то данных нет\n      .join('\\n\\n');\n    \n    formattedDocuments.push(singleDocText);\n  }\n}\n\n// Объединяем ВСЕ документы через ДВЕ пустые строки\nconst finalMergedText = formattedDocuments.join('\\n\\n\\n');\n\n// Возвращаем результат в виде одного json-объекта\nreturn [{\n  json: {\n    mergedText: finalMergedText,\n    totalDocuments: formattedDocuments.length,\n    status: \"success\"\n  }\n}];"
      },
