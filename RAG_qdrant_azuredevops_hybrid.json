    {
      "parameters": {
        "jsCode": "const documents = $input.all();\nconst query = $(\"Chat\").first().json.chatInput || \"\";\n\n// Фильтруем исходные элементы, чтобы сохранить связь между индексом текста и полным объектом документа\n// АДАПТАЦИЯ: данные теперь приходят в payload, а не в document\nconst validDocuments = documents.filter(d => {\n  const text = d.json.payload?.pageContent;\n  return typeof text === 'string' && text.trim().length > 0;\n});\n\nconst pageContents = validDocuments.map(d => d.json.payload.pageContent);\n\ntry {\n  const response = await helpers.httpRequest({\n    method: 'POST',\n    url: 'http://10.1.222.23:8003/rerank',\n    timeout: 60000,  // 30 секунд на случай большой нагрузки\n    body: {\n      model: \"BAAI/bge-reranker-v2-m3\",\n      query: query,\n      documents: pageContents\n    }\n  });\n\n  // 1. Сортируем и берем ТОП-1 результат\n  const topResults = response.results\n    .sort((a, b) => b.relevance_score - a.relevance_score)\n    .slice(0, 1);\n\n  // Если после фильтрации ничего не нашли — возвращаем заглушку\n  if (topResults.length === 0) {\n    return [{ \n      json: { \n        document: {\n          pageContent: \"Ничего не найдено по вашему запросу.\", \n          metadata: { filename: \"пусто\" }\n        },\n        relevance_score: 0, \n        status: \"empty\" \n      } \n    }];\n  }\n\n  // ================================================================\n  //  Отсечение по порогу релевантности\n  // (дабы убрать вопросы типа \"В чем смысл жизни?\") ================================================================\n  // Порог релевантности (экспериментальное значение, можно менять)\n  // Рекомендуемый диапазон: 0.3 - 0.7\n  // - 0.3: более либеральный (пропускает больше документов, но может быть шум)\n  // - 0.5: сбалансированный (рекомендуется для начала)\n  // - 0.7: строгий (только очень релевантные документы)\n  const RELEVANCE_THRESHOLD = 0.5;\n  \n  // Проверяем, превышает ли топ-1 результат порог\n  const topScore = topResults[0]?.relevance_score || 0;\n  \n  if (topScore < RELEVANCE_THRESHOLD) {\n    // Если самый релевантный документ ниже порога - возвращаем специальный статус\n    return [{\n      json: {\n        document: {\n          pageContent: \"NO_RELEVANT_INFO\", // Специальный маркер для промпта\n          metadata: { \n            filename: \"не_найдено\",\n            // Сохраняем фактический score для анализа\n            relevance_score_actual: topScore,\n            threshold_used: RELEVANCE_THRESHOLD\n          }\n        },\n        relevance_score: topScore,\n        status: \"no_results\" // Специальный статус для обработки в промпте\n      }\n    }];\n  }\n  \n  // 2. Сопоставляем индексы реранкера с исходными документами (текст + метаданные)\n  const finalOutput = topResults.map(res => {\n    // АДАПТАЦИЯ: берем данные из payload\n    const originalPayload = validDocuments[res.index].json.payload || {};\n\n    return {\n      json: {\n        document: {\n          pageContent: originalPayload.pageContent,\n          metadata: originalPayload.metadata || {} // Сохраняем исходные метаданные (путь, имя файла)\n        },\n        relevance_score: res.relevance_score,\n        status: \"success\"\n      }\n    };\n  });\n\n  return finalOutput;\n\n} catch (error) {\n  return [{ \n    json: { \n      document: {\n        pageContent: `Ошибка сервиса реранкинга: ${error.message}`, \n        metadata: { filename: \"ошибка\" }\n      },\n      relevance_score: 0,\n      status: \"error\" \n    } \n  }];\n}"
      },
